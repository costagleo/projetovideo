# ============================================
# Axidia Video Render v3 — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- Banco de Dados ----------
DB_PATH=/data/db/app.db

# ---------- Caminhos ----------
DATA_DIR=/data
CURRENT_SECTION_PATH=/data/projects/current

# ---------- Usuário MASTER ----------
MASTER_EMAIL=admin@axidia.com.br
MASTER_PASSWORD=DEFINA_UMA_SENHA_FORTE

# ---------- Autenticação (JWT) ----------
SECRET_KEY=GERE_UMA_CHAVE_SECRETA_ALEATORIA
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ---------- Registro ----------
REGISTRATION_MODE=invite_only

# ---------- Limites ----------
MAX_PROJECT_BYTES=3221225472
WORKER_CONCURRENCY=1
DEFAULT_PRESET=balanced

# ---------- App ----------
BASE_URL=https://video.axidia.com.br
